# Copy to backend/.env and fill in. Nothing here has a code default any more —
# the app refuses to start without ENCRYPTION_KEY, and payments/email are
# disabled until their keys are set.

# --- Security (required) ---
# Stable 32+ char random strings. Rotating ENCRYPTION_KEY makes existing
# encrypted bank details / gateway secrets unreadable.
JWT_SECRET=
ENCRYPTION_KEY=

# --- Database (optional) ---
# PostgreSQL connection string. If unset, a local WAL SQLite file is used.
DATABASE_URL=

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
# Comma-separated extra allowed origins (deploy + preview URLs).
EXTRA_CORS_ORIGINS=

# --- Razorpay platform account (required for any payment) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard. If unset, the webhook is
# processed WITHOUT signature verification (a warning is logged) — set it.
RAZORPAY_WEBHOOK_SECRET=

# --- Email (required for auth OTP + notifications) ---
BREVO_API_KEY=
EMAIL_FROM_NAME=Stall Wise
EMAIL_FROM_ADDRESS=
