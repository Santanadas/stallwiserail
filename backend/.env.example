# Copy to backend/.env and fill in. Nothing here has a code default any more —
# the app refuses to start without ENCRYPTION_KEY, and payments/email are
# disabled until their keys are set.

# --- Security (required) ---
# Stable 32+ char random strings. Rotating ENCRYPTION_KEY makes existing
# encrypted bank details / gateway secrets unreadable.
JWT_SECRET=
ENCRYPTION_KEY=

# --- Database (optional) ---
# PostgreSQL connection string. If unset, a local WAL SQLite file is used.
DATABASE_URL=

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
# Comma-separated extra allowed origins (deploy + preview URLs).
EXTRA_CORS_ORIGINS=

# --- Razorpay platform account (required for any payment) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard. If unset, the webhook is
# processed WITHOUT signature verification (a warning is logged) — set it.
RAZORPAY_WEBHOOK_SECRET=

# --- Email (required for auth OTP + notifications) ---
BREVO_API_KEY=
EMAIL_FROM_NAME=Stall Wise
EMAIL_FROM_ADDRESS=

# --- AI product descriptions (optional) ---
# Without a key the server still boots; the "Write with AI" button is simply
# hidden in the product editor.
# Get a key at build.nvidia.com. Put the real value here — a literal
# "$NVIDIA_API_KEY" is not expanded by Python and will 403.
NVIDIA_API_KEY=

# Any OpenAI-compatible chat-completions endpoint works. Defaults shown.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-v4-flash-0731
# AI_API_KEY=            # use instead of NVIDIA_API_KEY when pointing elsewhere

# deepseek-v4-flash is TEXT-ONLY, so product photos are not sent and the model
# is told it cannot see the item. Set true ONLY with a vision-capable AI_MODEL.
AI_VISION=false

# Reasoning is off: the seller watches this stream in a modal and a hundred
# words of product copy does not need it.
AI_THINKING=false
AI_REASONING_EFFORT=high
AI_MAX_TOKENS=1200
